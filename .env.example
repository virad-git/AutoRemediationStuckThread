# Auto Remediation - Stuck Thread Manager

Environment variables configuration file.

# FastAPI Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# GEMINI API Settings (Optional - for LLM features)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# Ansible Tower Settings
ANSIBLE_TOWER_URL=https://tower.ikea.com
ANSIBLE_JOB_TEMPLATE_ID=6782
ANSIBLE_TOKEN=your_ansible_token_here

# LangChain Settings
LANGCHAIN_DEBUG=False
